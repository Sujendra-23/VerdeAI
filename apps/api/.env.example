PORT=4000

# Leave both unset to run against the seeded mock dataset instead of Cosmos DB.
COSMOS_DB_ACCOUNT_URI=
COSMOS_DB_KEY=
COSMOS_DB_DATABASE=

# Leave unset to fall back to a deterministic templated explanation (no LLM call).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=verdeai-explainer
AZURE_OPENAI_API_KEY=

# Cosmos mode only: apply pending schema migrations when the API starts (default true).
# Set to false to run them as a separate step: npm run migrate -w @verdeai/api
MIGRATE_ON_STARTUP=true
