PORT=4000

# Leave both unset to run against the seeded mock dataset instead of Cosmos DB.
COSMOS_DB_ACCOUNT_URI=
COSMOS_DB_KEY=
COSMOS_DB_DATABASE=

# Leave unset to fall back to a deterministic templated explanation (no LLM call).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=verdeai-explainer
AZURE_OPENAI_API_KEY=
